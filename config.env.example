# ============================================================
# 理财助手 · 部署配置模板(复制为 config.env 后填真实值; 本文件可提交, 不含真实密钥)
# 优先级: os.environ > config.env。修改后重启服务生效。
# 格式约定:
#   1) 所有值可用双引号包裹(仅为辨认, 加载时自动去掉), 不包也行;
#   2) 多行 PEM 私钥必须用一对双引号包住整段(含真实换行), db.py 与 python-dotenv 均可读。
# ============================================================

# --- 数据库 ---
PG_DSN="postgresql://postgres:你的密码@localhost:5432/allassets"
PG_DSN_TEST=""

# --- 服务器 ---
HOST="0.0.0.0"
PORT="8888"

# --- 数据源凭证(部署人自己的, 全部用户共用) ---
# 同花顺 fuyao: x-api-key
THS_API_KEY="sk-fuyao-xxxxxxxxxxxxxxxxxxxxxxxx"
# TickFlow: x-api-key
TICKFLOW_API_KEY="tk_xxxxxxxxxxxxxxxxxxxxxxxx"
TICKFLOW_API_HOST="https://api.tickflow.org"

# 富途 OpenAPI REST(AppKey + Ed25519 私钥 PEM 全文):
#   私钥整段用一对双引号包住, 内部为真实换行(不要写成 \n 转义)
FUTU_API_HOST="https://webapi.futunn.com"
FUTU_APP_KEY="你的futu_app_key"
FUTU_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEI你的ed25519私钥base64正文（单行）在此
-----END PRIVATE KEY-----"
FUTU_SIGN_ALGO="ed25519"

# --- 可选数据源/开关 ---
TDX_BASE_URL=""
MARKET_PROVIDER=""            # 留空按默认; 可填 futu / ths / tickflow
QUOTE_AUTO_FETCH=""           # 非空时启用报价自动抓取(部署开关)
CRYPTO_PROXY=""               # 加密货币行情代理(可选)

# --- 大模型(均可选, 均有内置默认值; 留空走默认) ---
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_API_KEY_HEADER=""
LLM_PROXY=""
LLM_MODEL_MAP=""              # 例如: default=gpt-4o,cheap=gpt-4o-mini
